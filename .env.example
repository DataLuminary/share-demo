# DataView origin hosting the public embed page.
# Local Demo SPA. Production customer demo: https://demo.dataluminary.dev
PUBLIC_APP_ORIGIN=http://localhost:3013

# Optional overrides. Empty uses the seeded Demo gallery share
# (space 00000000-0000-4000-8000-00000000d101, dashboard 电商增长指挥大屏).
PUBLIC_SHARE_UID=
PUBLIC_SHARE_TOKEN=

# Optional: reverse-proxied DataTalk base URL
PUBLIC_PROXY=

# Optional: override JS SDK script. Default is {appOrigin}/sdk/luminary.min.js
PUBLIC_SDK_CDN_URL=
