# DataView origin hosting the public embed page
PUBLIC_APP_ORIGIN=https://app.dataluminary.dev

# Dedicated public demo share (will be baked into the static build)
PUBLIC_SHARE_UID=
PUBLIC_SHARE_TOKEN=

# Optional: reverse-proxied DataTalk base URL
PUBLIC_PROXY=

# Optional: override JS SDK CDN (default: jsDelivr @sdk-latest)
PUBLIC_SDK_CDN_URL=
